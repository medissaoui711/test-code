# TestPilot Environment Variables Example
# Duplicate this file to .env and fill in the values

# Gemini API Key for AI Analysis
GEMINI_API_KEY=

# GitHub App Configuration (Optional for Private Repos)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database Configuration (Optional - currently using session-isolated browser storage)
# DATABASE_URL=
